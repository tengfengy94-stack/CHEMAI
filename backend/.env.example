# 复制成 backend/.env 后按需修改；.env 不会进版本库。
# 开发/生产：prod 下必须显式配置 CHEMAI_JWT_SECRET，且默认不插入演示账号。
CHEMAI_ENV=dev
# 生产环境必须设置一个足够长的随机值；开发环境留空会自动生成本地 .jwt-secret。
CHEMAI_JWT_SECRET=
# 生产环境默认不插演示账号；确实需要时显式设 1。
CHEMAI_SEED_DEMO=

# 假模型开关：1 表示不联网、用固定回答跑通整套流程。
CHEMAI_FAKE_MODEL=1

# OpenAI 兼容服务的地址、密钥、模型名。假模型阶段密钥可以留空；
# 关掉假模型后，密钥缺失也会自动回退到假模型。
CHEMAI_MODEL_BASE_URL=https://api.openai.com/v1
CHEMAI_MODEL_API_KEY=
CHEMAI_MODEL_NAME=gpt-4o-mini
